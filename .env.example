# ── 必填 ──
# 登录密码:手机/其他设备访问必填(不填只允许本机);远程部署请用 16 位以上随机串,生成:openssl rand -base64 18
MCC_PASSWORD=

# ── 手机/平板/外网访问时填(见 AGENTS.md「二、手机、平板怎么连」)──
# 监听地址:留空 = 只听本机 127.0.0.1(反代、内网穿透都用这个);lan = 同一 Wi-Fi 的手机平板能连(只绑局域网网卡,另留本机);也可填具体地址
MCC_HOST=
# Cookie 签名密钥:不填每次重启随机(要重新登录);生成:openssl rand -hex 32
MCC_AUTH_SECRET=

# ── 可选 ──
# 网页端口(默认 47834)
MCC_PORT=
# 共用工作区:所有终端都在这里干活,AI 会按任务自己建子目录(默认 ~/mcc-workspace)
MCC_WORKSPACE=
# 额外允许 [SHARE:] 审阅的根目录,冒号分隔(默认只允许工作区和 /tmp)
MCC_SHARE_ROOTS=

# ── 模型(三选一即可;都没有时终端无回复)──
# 1) Claude 账号:不用填这里,在服务器上执行 claude 按提示登录
# 2) Anthropic API key,申请 https://console.anthropic.com → API Keys;也可配 Anthropic 兼容网关地址
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# 3) DeepSeek key(国内好申请,充值即用),申请 https://platform.deepseek.com → API keys;填了新建终端默认用 DeepSeek
DEEPSEEK_API_KEY=

# ── 另外两种终端(新建终端时在「Actor 类型」里选;细则见 AGENTS.md「三种终端」)──
# Codex 终端:不填 key,在服务器上执行 codex login(ChatGPT 账号)或按 Codex 官方文档配 API key。
# 本机 codex 配置里改过 provider 时,可在这里追加 codex exec 的参数,例:-c model_provider="openai"
MCC_CODEX_ARGS=
# 傻循环终端:任一兼容端点(下面三个必须同时填),方言 anthropic(默认)或 openai
LIFE_API=
LIFE_KEY=
LIFE_MODEL=
LIFE_DIALECT=
# 傻循环不另配时:填了上面的 DEEPSEEK_API_KEY 就用 DeepSeek;填了 ANTHROPIC_API_KEY 且模型选 claude-* 就用 Anthropic。
# 傻循环需要 python3 ≥ 3.8(命令行 python3 --version)

# 慢聊用 Claude 模型时的 Anthropic 兼容网关地址与 key(默认官方 https://api.anthropic.com/v1/messages)
PROVIDER_CHAT_URL=
PROVIDER_CHAT_KEY=
# 设 1 开逐请求抓包(上下文检视器逐字查看请求体,落盘到 ~/.cache)
MCC_CAPTURE=
